<?xml version="1.0" encoding="utf-8"?>
<!-- The island, narrow: the orb and what it's doing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/island_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/island_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="10dp"
  android:paddingEnd="12dp">

  <ImageView
    android:id="@+id/island_widget_orb"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:contentDescription="@string/island_widget_name"
    android:scaleType="fitCenter" />

  <TextView
    android:id="@+id/island_widget_line"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="Island"
    android:textColor="@color/island_widget_text"
    android:textSize="14sp"
    android:textStyle="bold" />
</LinearLayout>
