<?xml version="1.0" encoding="utf-8"?>
<!-- The island, wide: the orb, its name, what it's doing, and the computer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/island_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/island_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingEnd="16dp"
  android:paddingTop="10dp"
  android:paddingBottom="10dp">

  <ImageView
    android:id="@+id/island_widget_orb"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:contentDescription="@string/island_widget_name"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/island_widget_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Open Island Drop to connect"
      android:textColor="@color/island_widget_text"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/island_widget_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Island"
      android:textColor="@color/island_widget_text2"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
